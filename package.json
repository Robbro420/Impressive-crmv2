{
  "name": "impressive-crm",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @workspace/api-server run dev",
    "dev:web": "pnpm --filter @workspace/robbanbro-crm run dev",
    "build": "pnpm run typecheck && pnpm --filter @workspace/robbanbro-crm run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"@workspace/*\" --if-present run typecheck",
    "db:push": "pnpm --filter @workspace/db run push",
    "seed": "pnpm --filter @workspace/scripts run seed"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
